# ── Core ─────────────────────────────────────────────────────
CLAUDE_API_KEY=           # Anthropic — required, server won't start without it
OPENWEATHER_API_KEY=      # OpenWeatherMap
OPENWEATHER_CITY=Pune
PORCUPINE_ACCESS_KEY=     # Wake word detection
PORT=3000
NODE_ENV=production

# Shared secret protecting /api/* and the Socket.io handshake.
# Optional — if left blank, one is auto-generated and saved to config/api-key.
# LAN clients (phone companion) authenticate automatically via a same-origin
# cookie; set this only if you want a fixed key for programmatic access.
MIRROR_API_KEY=

# ── Spotify ──────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Audio plays on the mirror's own Spotify Connect device (Raspotify/librespot).
# This is the device name the Web API targets; must match Raspotify's device
# name (see scripts/setup-raspotify.sh). Default: Mira
SPOTIFY_DEVICE_NAME=Mira

# ── Google (Calendar, Gmail) ─────────────────────────────────
# OAuth client is only needed for the LEGACY Google API path. The default,
# product path uses no Google API:
#   • Calendar → config/calendar.json  { "icalUrl": "<secret .ics URL>" }
#                (Google Calendar → Settings → your calendar → Integrate calendar
#                 → "Secret address in iCal format")
#   • Gmail    → config/imap.json  { "email": "...", "appPassword": "<16-digit>" }
#                (Google Account → Security → App passwords; needs 2-Step Verification)
# Both are configured from the phone setup wizard; leave these blank unless you
# specifically want the old OAuth API path.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── News ─────────────────────────────────────────────────────
NEWSAPI_KEY=

# ── Fitness ──────────────────────────────────────────────────
EXERCISEDB_API_KEY=

# ── Morning Briefing Auto-Trigger ────────────────────────────

# Cron schedule for fixed-time briefing
# Default: 7:00 AM IST every day
BRIEFING_CRON=0 7 * * *

# Enable/disable PIR motion auto-trigger
# Set to 'false' to disable PIR triggering
# Default: true
BRIEFING_PIR_TRIGGER=true

# Morning window — briefing only fires if PIR motion detected in this window
# Window: BRIEFING_WINDOW_START:00 to BRIEFING_WINDOW_END:BRIEFING_WINDOW_END_MIN
# Default: 6:00 AM to 9:30 AM IST
BRIEFING_WINDOW_START=6
BRIEFING_WINDOW_END=9
BRIEFING_WINDOW_END_MIN=30

# Cooldown in hours after a briefing fires
# Prevents re-triggering if you leave/re-enter room
# Default: 2 hours
BRIEFING_COOLDOWN_HOURS=2

# Delay in milliseconds between PIR detection and briefing starting
# Gives person time to stand in front of mirror
# Default: 3000 (3 seconds)
BRIEFING_PIR_DELAY_MS=3000
